* {
    background: __BG__;
    color: __FG__;
    font-family: "Segoe UI";
    font-size: 13px;
    outline: none;
}

QMainWindow, QDialog {
    background: __BG__;
}

#microLabel {
    color: __SOFT__;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
}

#sidebar {
    background: __BG__;
    border-right: 1px solid __LINE__;
}

#githubLink {
    color: #888;
    font-size: 10px;
    font-family: "Segoe UI", "Arial", sans-serif;
}

#heroTitle {
    font-size: 28px;
    font-weight: 300;
    letter-spacing: 0.5px;
}

#heroBody {
    color: __BODY__;
    font-size: 12px;
    line-height: 160%;
}

#statCard {
    background: __ALT__;
    border: 1px solid __LINE__;
    border-radius: 8px;
    padding: 16px 20px;
}

#statNumber {
    font-size: 24px;
    font-weight: 300;
    letter-spacing: 0.5px;
}

QPushButton {
    background: __FG__;
    color: __BG__;
    border: 1px solid __FG__;
    border-radius: 4px;
    padding: 10px 20px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
}

QPushButton:hover {
    background: __SOFT__;
    border-color: __SOFT__;
}

QPushButton:pressed {
    background: __BG__;
    color: __FG__;
}

QPushButton:disabled {
    border-color: __LINE__;
    color: __SOFT__;
    background: __ALT__;
}

#navButton {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    padding: 14px 20px;
    text-align: left;
    letter-spacing: 3px;
    font-weight: 500;
    color: __SOFT__;
    font-size: 12px;
}

#navButton:hover {
    background: __HOVER__;
    color: __FG__;
}

#navButton:checked {
    background: __HOVER__;
    color: __FG__;
    border-left: 3px solid __FG__;
    font-weight: 600;
}

#panicButton {
    background: __FG__;
    color: __BG__;
    border: 1px solid __FG__;
    border-radius: 6px;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 10px;
    padding: 48px 0px;
}

#panicButton:hover {
    background: __BG__;
    color: __FG__;
}

#lineEdit, QSpinBox {
    border: 1px solid __LINE__;
    border-radius: 4px;
    padding: 8px 12px;
    background: __BG__;
    selection-background-color: __FG__;
    selection-color: __BG__;
}

#lineEdit:focus, QSpinBox:focus {
    border: 1px solid __FG__;
}

QTableWidget {
    border: 1px solid __LINE__;
    border-radius: 4px;
    gridline-color: transparent;
    selection-background-color: __HOVER__;
    selection-color: __FG__;
    alternate-background-color: __ALT__;
}

QTableWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid __LINE__;
}

QTableWidget::item:selected {
    background: __HOVER__;
}

QHeaderView::section {
    background: __BG__;
    border: none;
    border-bottom: 2px solid __FG__;
    padding: 10px 8px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2px;
    color: __SOFT__;
}

QCheckBox, QRadioButton {
    spacing: 12px;
    font-size: 12px;
    font-weight: 500;
    padding: 4px 0;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid __LINE__;
    border-radius: 4px;
    background: __BG__;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: __FG__;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: __FG__;
    border-color: __FG__;
}

QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
    background: __FG__;
    border-color: __FG__;
    opacity: 0.8;
}

QTextEdit {
    border: 1px solid __LINE__;
    border-radius: 4px;
    font-family: "Consolas";
    font-size: 11px;
    selection-background-color: __FG__;
    selection-color: __BG__;
}

QScrollBar:vertical {
    background: __BG__;
    width: 6px;
    border: none;
}

QScrollBar::handle:vertical {
    background: __HANDLE__;
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    height: 0px;
    width: 0px;
    background: none;
}

#divider {
    background-color: transparent;
    max-height: 1px;
    border: none;
}

#statusBar {
    background: __BG__;
    border-top: 1px solid __LINE__;
}

#cliBar {
    background: __BG__;
    border-top: 1px solid __LINE__;
}

#promptMark {
    font-family: "Consolas";
    font-size: 15px;
    font-weight: 700;
    color: __FG__;
    background: transparent;
}

#cliInput {
    background: __BG__;
    color: __FG__;
    border: none;
    caret-color: __FG__;
    font-family: "Consolas";
    font-size: 13px;
    padding: 6px 2px;
    selection-background-color: __FG__;
    selection-color: __BG__;
}

#cliInput::placeholder {
    color: __SOFT__;
}

#cliOutput {
    background: __BG__;
    color: __FG__;
    border: none;
    font-family: "Consolas";
    font-size: 12px;
    selection-background-color: __FG__;
    selection-color: __BG__;
}

#cliTitle {
    color: __SOFT__;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 3px;
    background: transparent;
}

#cliHide {
    background: transparent;
    color: __SOFT__;
    border: 1px solid __LINE__;
    border-radius: 3px;
    padding: 2px 10px;
    letter-spacing: 1px;
}

#cliHide:hover {
    background: __FG__;
    color: __BG__;
    border-color: __FG__;
}

#hintLabel {
    color: __SOFT__;
    font-size: 9px;
    letter-spacing: 2px;
}

#sectionFrame {
    border: none;
    border-top: 1px solid __LINE__;
}

#terminalOutput {
    background: __BG__;
    color: __FG__;
    border: 1px solid __LINE__;
    border-radius: 4px;
    font-family: "Consolas";
    font-size: 12px;
    selection-background-color: __FG__;
    selection-color: __BG__;
}

#terminalInput {
    background: __BG__;
    color: __FG__;
    border: 1px solid __LINE__;
    border-radius: 4px;
    caret-color: __FG__;
    font-family: "Consolas";
    font-size: 13px;
    padding: 8px 6px;
    selection-background-color: __FG__;
    selection-color: __BG__;
}

#terminalInput:focus {
    border: 1px solid __FG__;
}

#floatFrame {
    background: transparent;
    border: none;
}

#floatPanicBtn {
    background: transparent;
    border: none;
    border-radius: 50%;
    padding: 0px;
}

#floatPanicBtn:hover {
    opacity: 0.85;
}

#floatPanicBtn:pressed {
    opacity: 0.7;
}

#statusBadge {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 3px 10px;
    border-radius: 10px;
    background: __HOVER__;
    color: __FG__;
}

#badgeFound {
    background: __FG__;
    color: __BG__;
}

#badgeEmpty {
    background: __HOVER__;
    color: __SOFT__;
}

#badgeLocked {
    background: __HOVER__;
    color: __SOFT__;
}

#badgeReady {
    background: __HOVER__;
    color: __FG__;
}

#badgeError {
    background: __HOVER__;
    color: __SOFT__;
}

#progressBar {
    border: none;
    border-radius: 2px;
    max-height: 4px;
    background: __LINE__;
}

#progressBar::chunk {
    background: __FG__;
    border-radius: 2px;
}

#toolChip {
    background: __HOVER__;
    border: 1px solid __LINE__;
    border-radius: 6px;
    padding: 10px 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    color: __FG__;
}

#toolChip:hover {
    background: __FG__;
    color: __BG__;
    border-color: __FG__;
}

#toolChip:checked {
    background: __FG__;
    color: __BG__;
    border-color: __FG__;
}

#scanSummary {
    color: __SOFT__;
    font-size: 11px;
    letter-spacing: 1px;
}

#toolSectionTitle {
    color: __SOFT__;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 3px;
}

#cliSessionStatus {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1px;
}

#cliSessionActive {
    color: __FG__;
}

#cliSessionIdle {
    color: __SOFT__;
}
